{
    "label": "logout",
    "action": "hyprctl dispatch exit",
    "text": "Logout",
    "keybind": "l"
}
{
    "label": "sleep",
    "action": "systemctl suspend",
    "text": "Sleep",
    "keybind": "s"
}
{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Reboot",
    "keybind": "r"
}
{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shutdown",
    "keybind": "p"
}
