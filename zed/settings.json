{
  "cli_default_open_behavior": "existing_window",

  // Auto updates
  "auto_update": false,

  // AI
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "extension",
      "favorite_models": ["zai-coding-plan/glm-4.7"],
      "default_config_options": {},
      "favorite_config_option_values": {},
    },
  },
  "disable_ai": true,
  "show_edit_predictions": false,

  // Editor Behaviour & Navigation
  "vim_mode": true,
  "command_aliases": {
    "W": "w",
  },
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "format_on_save": "on",
  "colorize_brackets": true,
  "show_wrap_guides": true,
  "selection_highlight": false,
  "show_inlay_code_actions": false,
  "inlay_hints": {
    "enabled": false,
  },
  "completions": {
    "lsp_insert_mode": "replace_subsequence",
  },
  "extend_comment_on_newline": false,

  // LSP
  "languages": {
    "Python": {
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
      "language_servers": ["ty", "!pyrefly", "!basedpyright", "ruff", "!pylsp"],
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
    "Java": {
      "language_servers": ["jdtls"],
    },
    "JavaScript": {
      "inlay_hints": {
        "enabled": true,
      },
      "language_servers": [
        "vtsls",
        "!tailwindcss-language-server",
        "!typescript-language-server",
      ],
    },
    "TypeScript": {
      "inlay_hints": {
        "enabled": true,
      },
      "language_servers": [
        "vtsls",
        "!tailwindcss-language-server",
        "!typescript-language-server",
      ],
    },
  },

  "lsp": {
    "ty": {
      "binary": {
        "path": "/home/maks/.local/bin/ty",
        "arguments": ["server"],
      },
    },
    "jdtls": {
      "binary": {
        "path": "/home/maks/jdtls/bin/jdtls",
        "arguments": [
          "-configuration",
          "/home/maks/jdtls/config_linux",
          "-data",
          "/home/maks/.config/zed/jdtls-workspace",
        ],
      },
    },
    "vtsls": {
      "binary": {
        "path": "/usr/local/sbin/vtsls",
        "arguments": ["--stdio"],
      },
    },
  },

  // Search
  "search": {
    "regex": true,
    "button": false,
  },
  "use_smartcase_search": true,

  // Diagnostics & Linting
  "diagnostics": {
    "button": false,
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 75,
      "padding": 4,
      "min_column": 0,
      "max_severity": "hint",
    },
  },

  // UI Layout & Panels
  "which_key": {
    "enabled": true,
    "delay_ms": 100,
  },
  "agent": {
    "button": false,
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": true,
    "agent_review": false,
  },
  "outline_panel": {
    "button": false,
    "dock": "right",
  },
  "terminal": {
    "font_family": "BlexMono Nerd Font Mono",
    "font_weight": 400.0,
    "dock": "bottom",
    "button": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "git_panel": {
    "tree_view": false,
    "button": false,
  },
  "notification_panel": {
    "button": false,
  },
  "edit_predictions": {
    "provider": "none",
  },
  "project_panel": {
    "button": false,
    "indent_size": 20,
    "default_width": 200,
    "entry_spacing": "comfortable",
    "file_icons": true,
    "folder_icons": true,
    "auto_fold_dirs": false,
    "auto_reveal_entries": true,
    "dock": "left",
  },
  "tab_bar": {
    "show": true,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
  },
  "tabs": {
    "show_close_button": "hover",
    "file_icons": true,
  },
  "scrollbar": {
    "show": "never",
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "fixed",
    "active_line_width": 2,
  },
  "gutter": {
    "line_numbers": true,
    "folds": false,
  },
  "title_bar": {
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_branch_name": false,
    "show_project_items": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_menus": false,
  },
  "status_bar": {
    "active_language_button": false,
  },
  "global_lsp_settings": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
  },

  // Apperance & Theme
  "ui_font_size": 14.0,
  "ui_font_family": "IBM Plex Sans",
  "buffer_font_size": 13.0,
  "buffer_font_family": "BlexMono Nerd Font Mono",
  "buffer_font_weight": 500.0,
  "buffer_line_height": "comfortable",
  "theme": "Catppuccin Mocha (Blur) [Heavy]",
  "icon_theme": "Colored Zed Icons Theme Dark",

  "theme_overrides": {
    "Tokyo Night Storm": {
      "element.hover": "#364b54",
      "element.selected": "#363b54",
      "ghost_element.hover": "#363b54",
      "ghost_element.selected": "#363b54",
      "tab.active_background": "#363b54",
    },
    "Tokyo Night Moon": {
      "element.hover": "#364b54",
      "element.selected": "#363b54",
      "ghost_element.hover": "#363b54",
      "ghost_element.selected": "#363b54",
      "tab.active_background": "#363b54",
    },
  },

  // Stats & Telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
