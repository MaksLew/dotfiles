{
  // Auto updates
  "auto_update": false,

  // AI
  "disable_ai": false,
  "show_edit_predictions": false,

  // Editor Behaviour & Navigation
  "diff_view_style": "unified",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "format_on_save": "off",
  "colorize_brackets": false,
  "show_wrap_guides": true,
  "selection_highlight": false,
  "inlay_hints": {
    "enabled": false,
  },
  "completions": {
    "lsp_insert_mode": "insert",
  },
  "extend_comment_on_newline": false,
  "autosave": "on_focus_change",
  "cli_default_open_behavior": "existing_window",

  // LSP
  "languages": {
    "Python": {
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
      "language_servers": ["ty", "!pyrefly", "!basedpyright", "ruff", "!pylsp"],
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
    "Typst": {
      "language_servers": ["tinymist"],
    },
  },

  "lsp": {
    "ty": {
      "binary": {
        "path": "/home/makslew/.local/bin/ty",
        "arguments": ["server"],
      },
    },
    "tinymist": {
      "binary": {
        "path": "/home/makslew/.cargo/bin/tinymist",
        "arguments": ["lsp"],
      },
    },
  },

  // Search
  "search": {
    "regex": true,
    "button": false,
  },
  "use_smartcase_search": true,

  // Diagnostics & Linting
  "diagnostics": {
    "button": false,
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 75,
      "padding": 4,
      "min_column": 0,
      "max_severity": "hint",
    },
  },

  // UI Layout & Panels
  "which_key": {
    "enabled": true,
    "delay_ms": 500,
  },
  "agent": {
    "enable_feedback": false,
    "dock": "right",
    "button": false,
    "sidebar_side": "right",
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
  },
  "outline_panel": {
    "button": false,
    "dock": "right",
  },
  "terminal": {
    "font_size": 13.0,
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_weight": 400.0,
    "dock": "bottom",
    "button": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "git_panel": {
    "dock": "left",
    "tree_view": false,
    "button": false,
  },
  "edit_predictions": {
    "provider": "none",
  },
  "project_panel": {
    "button": false,
    "indent_size": 20,
    "default_width": 200,
    "entry_spacing": "comfortable",
    "file_icons": true,
    "folder_icons": true,
    "auto_fold_dirs": false,
    "auto_reveal_entries": true,
    "dock": "left",
  },
  "tab_bar": {
    "show": true,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
  },
  "tabs": {
    "show_close_button": "hover",
    "file_icons": true,
  },
  "scrollbar": {
    "show": "never",
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "fixed",
    "active_line_width": 2,
  },
  "gutter": {
    "line_numbers": true,
    "folds": false,
    "runnables": false,
  },
  "title_bar": {
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_branch_name": false,
    "show_project_items": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_menus": false,
  },
  "status_bar": {
    "active_language_button": false,
    "experimental.show": false,
  },
  "global_lsp_settings": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
  },

  // Apperance & Theme
  "text_rendering_mode": "subpixel",
  "ui_font_size": 14.0,
  "ui_font_family": "IBM Plex Sans",
  "buffer_font_size": 13.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_weight": 400.0,
  "buffer_line_height": "standard",
  "theme": "Catppuccin Mocha - No Italics",
  "icon_theme": "Colored Zed Icons Theme Dark",

  "theme_overrides": {
    "Catppuccin Mocha - No Italics": {
      "border.variant": "#313244",
      "background.appearance": "blurred",
      "title_bar.background": "#11111ba6",
      "surface.background": "#18182500",
      "editor.background": "#1e1e2e00",
      "terminal.background": "#00000000",
      "panel.background": "#00000000",
      "tab_bar.background": "#11111b50",
      "background": "#1e1e2ef0",
    },
  },

  // Stats & Telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
